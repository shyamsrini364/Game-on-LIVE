# Optional local PostgreSQL. Leave unset to use local SQLite.
# Never replace this example with real credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
GAMEON_SCHEMA=gameon_preview
# GAMEON_DB=data/gameon.sqlite3
# GAMEON_RATE_LIMIT_SECRET=generate-a-long-random-secret
# Public, keyless basemap settings (also configure for the Vercel Preview environment).
# Never put private tokens in these values: the browser receives this configuration.
GAMEON_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
GAMEON_MAP_RESOURCE_ORIGINS=https://tiles.openfreemap.org
